Project TrackerV2 {
  database_type: 'PostgreSQL'
  Note: 'Generic product discovery, price comparison, affiliate and tracking platform. Initial domain: fashion and beauty. Other domains use the same core tables.'
}

// 1. LOCALIZATION
Table Language {
  language_code varchar(10) [pk, not null]
  native_name varchar(100) [not null]
  is_active boolean [not null, default: true]

  checks {
    `length(trim(native_name)) > 0` [name: 'CK_Language_NativeName']
  }
}

// 2. CATALOG
Table Category {
  category_id integer [pk, increment]
  parent_category_id integer [null]
  slug varchar(150) [not null, unique]
  is_active boolean [not null, default: true]

  checks {
    `length(trim(slug)) > 0` [name: 'CK_Category_Slug']
    `parent_category_id IS NULL OR parent_category_id <> category_id` [name: 'CK_Category_NotOwnParent']
  }
  Note: 'Hierarchy for any domain. Prevent deeper parent cycles in application logic.'
}

Table CategoryTranslation {
  category_id integer [not null]
  language_code varchar(10) [not null]
  name varchar(150) [not null]
  description text

  checks {
    `length(trim(name)) > 0` [name: 'CK_CategoryTranslation_Name']
  }

  indexes {
    (category_id, language_code) [pk]
  }
}

Table Product {
  product_id integer [pk, increment]
  brand varchar(150)
  image_url text [note: 'Primary product image; additional media can be modeled later']
  specifications jsonb [note: 'Shared, language-neutral characteristics; JSON object']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `specifications IS NULL OR jsonb_typeof(specifications) = 'object'` [name: 'CK_Product_Specifications']
    `updated_at >= created_at` [name: 'CK_Product_Dates']
  }
}

Table ProductTranslation {
  product_id integer [not null]
  language_code varchar(10) [not null]
  name varchar(255) [not null]
  description text

  checks {
    `length(trim(name)) > 0` [name: 'CK_ProductTranslation_Name']
  }

  indexes {
    (product_id, language_code) [pk]
  }
}

Table ProductCategory {
  product_id integer [not null]
  category_id integer [not null]

  indexes {
    (product_id, category_id) [pk]
  }
}

Table ProductVariant {
  variant_id integer [pk, increment]
  product_id integer [not null]
  variant_code varchar(100) [not null, note: 'Use DEFAULT for products without variations']
  gtin varchar(14) [unique, note: 'Optional global product barcode']
  image_url text [note: 'Optional variation-specific image (e.g., color)']
  attributes jsonb [note: 'Variant-specific codes such as size, color, capacity; JSON object']
  is_active boolean [not null, default: true]

  indexes {
    (product_id, variant_code) [unique, name: 'UQ_Variant_ProductCode']
  }
  checks {
    `length(trim(variant_code)) > 0` [name: 'CK_Variant_Code']
    `attributes IS NULL OR jsonb_typeof(attributes) = 'object'` [name: 'CK_Variant_Attributes']
  }
}

// 3. MERCHANT OFFERS AND PRICE HISTORY
Table Merchant {
  merchant_id integer [pk, increment]
  name varchar(255) [not null]
  website_url text
  supports_affiliate_links boolean [not null, default: false]
  is_active boolean [not null, default: true]

  checks {
    `length(trim(name)) > 0` [name: 'CK_Merchant_Name']
  }
}

Table Offer {
  offer_id integer [pk, increment]
  merchant_id integer [not null]
  variant_id integer [not null]
  external_offer_id varchar(200) [note: 'Merchant listing ID may be shared by several size/color variants']
  product_url text [not null]
  affiliate_url text
  price numeric(18,2) [not null]
  shipping_cost numeric(18,2)
  currency varchar(3) [not null, note: 'ISO 4217 currency code']
  is_available boolean
  attributes jsonb [note: 'Listing-specific data: condition, mileage, seller details; JSON object']
  last_checked_at timestamptz [not null]

  indexes {
    (merchant_id, external_offer_id, variant_id) [unique, name: 'UX_Offer_Merchant_Listing_Variant']
    (variant_id, currency, price) [name: 'IX_Offer_PriceComparison']
  }
  checks {
    `length(trim(product_url)) > 0` [name: 'CK_Offer_ProductUrl']
    `price > 0` [name: 'CK_Offer_Price']
    `shipping_cost IS NULL OR shipping_cost >= 0` [name: 'CK_Offer_Shipping']
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Offer_Currency']
    `attributes IS NULL OR jsonb_typeof(attributes) = 'object'` [name: 'CK_Offer_Attributes']
  }
}

Table PriceHistory {
  price_history_id integer [pk, increment]
  offer_id integer [not null]
  price numeric(18,2) [not null]
  currency varchar(3) [not null]
  recorded_at timestamptz [not null, default: `now()`]

  indexes {
    (offer_id, recorded_at) [name: 'IX_PriceHistory_Offer_Date']
  }
  checks {
    `price > 0` [name: 'CK_PriceHistory_Price']
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_PriceHistory_Currency']
  }
}

// 4. USER ACCOUNTS AND GENERIC SAVED COLLECTIONS
Table User {
  user_id integer [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [not null]
  password_hash text [not null]
  preferred_language_code varchar(10)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (`lower(email)`) [unique, name: 'UX_User_Email']
  }
  checks {
    `length(trim(name)) > 0` [name: 'CK_User_Name']
    `length(trim(email)) > 0` [name: 'CK_User_Email']
  }
  Note: 'Hash passwords in application code. Email uniqueness is case-insensitive.'
}

Table SavedCollection {
  collection_id integer [pk, increment]
  user_id integer [not null]
  name varchar(255) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `updated_at >= created_at` [name: 'CK_Collection_Dates']
  }
}

Table SavedCollectionItem {
  collection_item_id integer [pk, increment]
  collection_id integer [not null]
  variant_id integer [not null]
  quantity integer [not null, default: 1]

  indexes {
    (collection_id, variant_id) [unique, name: 'UQ_Collection_Variant']
  }
  checks {
    `quantity > 0` [name: 'CK_CollectionItem_Quantity']
  }
}

// 5. SHARING AND AFFILIATE COMMISSIONS
Table ShareLink {
  share_link_id integer [pk, increment]
  product_id integer
  collection_id integer
  slug varchar(255) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true]

  checks {
    `length(trim(slug)) > 0` [name: 'CK_ShareLink_Slug']
    `(product_id IS NOT NULL AND collection_id IS NULL) OR (product_id IS NULL AND collection_id IS NOT NULL)` [name: 'CK_ShareLink_OneTarget']
  }
}

Table ShareLinkClick {
  click_id integer [pk, increment]
  share_link_id integer [not null]
  offer_id integer [not null]
  clicked_at timestamptz [not null, default: `now()`]

  Note: 'Backend must validate that the offer belongs to the linked product or collection.'
}

Table AffiliateConversion {
  conversion_id integer [pk, increment]
  merchant_id integer [not null]
  offer_id integer
  click_id integer
  external_conversion_id varchar(255)
  order_amount numeric(18,2)
  commission_amount numeric(18,2) [not null]
  currency varchar(3) [not null]
  status_scope varchar(50) [not null, default: 'affiliate_conversion']
  status_code varchar(50) [not null, default: 'pending']
  reported_at timestamptz [not null, default: `now()`]

  indexes {
    (merchant_id, external_conversion_id) [unique, name: 'UX_Conversion_Merchant_ExternalId']
  }
  checks {
    `status_scope = 'affiliate_conversion'` [name: 'CK_Conversion_StatusScope']
    `order_amount IS NULL OR order_amount >= 0` [name: 'CK_Conversion_OrderAmount']
    `commission_amount >= 0` [name: 'CK_Conversion_Commission']
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Conversion_Currency']
  }
}

// 6. ALERTS AND NOTIFICATIONS
Table PriceAlert {
  alert_id integer [pk, increment]
  user_id integer [not null]
  variant_id integer [not null]
  target_price numeric(18,2) [not null]
  currency varchar(3) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  last_triggered_at timestamptz

  indexes {
    (variant_id, currency, target_price) [name: 'IX_PriceAlert_Variant_Currency']
  }
  checks {
    `target_price > 0` [name: 'CK_Alert_TargetPrice']
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Alert_Currency']
    `last_triggered_at IS NULL OR last_triggered_at >= created_at` [name: 'CK_Alert_LastTriggered']
  }
}

Table Notification {
  notification_id integer [pk, increment]
  user_id integer [not null]
  alert_id integer
  title text [not null]
  message text [not null]
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Store notification text in the user language at creation time. Backend verifies alert belongs to same user.'
}

// 7. CRAWLING / DATA IMPORT
Table CrawlRun {
  crawl_run_id integer [pk, increment]
  merchant_id integer [not null]
  started_at timestamptz
  finished_at timestamptz
  status_scope varchar(50) [not null, default: 'crawl_run']
  status_code varchar(50) [not null, default: 'pending']
  products_found integer [not null, default: 0]
  error_message text

  checks {
    `status_scope = 'crawl_run'` [name: 'CK_CrawlRun_StatusScope']
    `products_found >= 0` [name: 'CK_CrawlRun_ProductsFound']
    `finished_at IS NULL OR (started_at IS NOT NULL AND finished_at >= started_at)` [name: 'CK_CrawlRun_Dates']
  }
}

Table CrawledListing {
  listing_id integer [pk, increment]
  crawl_run_id integer [not null]
  matched_variant_id integer
  product_name varchar(255) [not null]
  external_offer_id varchar(200)
  product_url text [not null]
  price numeric(18,2)
  currency varchar(3)
  raw_specifications jsonb [note: 'Raw JSON object extracted from merchant page']
  status_scope varchar(50) [not null, default: 'listing_match']
  status_code varchar(50) [not null, default: 'pending']
  crawled_at timestamptz [not null, default: `now()`]

  checks {
    `status_scope = 'listing_match'` [name: 'CK_Listing_StatusScope']
    `price IS NULL OR price > 0` [name: 'CK_Listing_Price']
    `price IS NULL OR currency IS NOT NULL` [name: 'CK_Listing_PriceCurrency']
    `currency IS NULL OR currency ~ '^[A-Z]{3}$'` [name: 'CK_Listing_Currency']
    `raw_specifications IS NULL OR jsonb_typeof(raw_specifications) = 'object'` [name: 'CK_Listing_Specifications']
  }
}

// 8. PROMOTIONS
Table SponsoredListing {
  sponsored_listing_id integer [pk, increment]
  offer_id integer [not null]
  start_date timestamptz [not null]
  end_date timestamptz [not null]
  sponsorship_fee numeric(18,2)
  currency varchar(3) [not null]
  is_active boolean [not null, default: true]

  checks {
    `end_date > start_date` [name: 'CK_Sponsored_Dates']
    `sponsorship_fee IS NULL OR sponsorship_fee >= 0` [name: 'CK_Sponsored_Fee']
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Sponsored_Currency']
  }
}

// 9. CONFIGURABLE WORKFLOW STATUSES
Table Status {
  scope varchar(50) [not null]
  code varchar(50) [not null]
  label_en varchar(100) [not null]
  label_ar varchar(100) [not null]
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]

  checks {
    `length(trim(label_en)) > 0` [name: 'CK_Status_LabelEn']
    `length(trim(label_ar)) > 0` [name: 'CK_Status_LabelAr']
  }

  indexes {
    (scope, code) [pk]
  }
  Note: 'Add new statuses using seed data, not a schema migration. Examples of scopes: crawl_run, listing_match, affiliate_conversion.'
}

// FOREIGN KEYS
Ref: Category.parent_category_id > Category.category_id [delete: restrict]
Ref: CategoryTranslation.category_id > Category.category_id [delete: cascade]
Ref: CategoryTranslation.language_code > Language.language_code [delete: restrict]
Ref: ProductTranslation.product_id > Product.product_id [delete: cascade]
Ref: ProductTranslation.language_code > Language.language_code [delete: restrict]
Ref: ProductCategory.product_id > Product.product_id [delete: cascade]
Ref: ProductCategory.category_id > Category.category_id [delete: restrict]
Ref: ProductVariant.product_id > Product.product_id [delete: restrict]
Ref: Offer.merchant_id > Merchant.merchant_id [delete: restrict]
Ref: Offer.variant_id > ProductVariant.variant_id [delete: restrict]
Ref: PriceHistory.offer_id > Offer.offer_id [delete: restrict]
Ref: User.preferred_language_code > Language.language_code [delete: restrict]
Ref: SavedCollection.user_id > User.user_id [delete: restrict]
Ref: SavedCollectionItem.collection_id > SavedCollection.collection_id [delete: cascade]
Ref: SavedCollectionItem.variant_id > ProductVariant.variant_id [delete: restrict]
Ref: ShareLink.product_id > Product.product_id [delete: restrict]
Ref: ShareLink.collection_id > SavedCollection.collection_id [delete: restrict]
Ref: ShareLinkClick.share_link_id > ShareLink.share_link_id [delete: restrict]
Ref: ShareLinkClick.offer_id > Offer.offer_id [delete: restrict]
Ref: AffiliateConversion.merchant_id > Merchant.merchant_id [delete: restrict]
Ref: AffiliateConversion.offer_id > Offer.offer_id [delete: set null]
Ref: AffiliateConversion.click_id > ShareLinkClick.click_id [delete: set null]
Ref: AffiliateConversion.(status_scope, status_code) > Status.(scope, code) [delete: restrict]
Ref: PriceAlert.user_id > User.user_id [delete: restrict]
Ref: PriceAlert.variant_id > ProductVariant.variant_id [delete: restrict]
Ref: Notification.user_id > User.user_id [delete: restrict]
Ref: Notification.alert_id > PriceAlert.alert_id [delete: set null]
Ref: CrawlRun.merchant_id > Merchant.merchant_id [delete: restrict]
Ref: CrawlRun.(status_scope, status_code) > Status.(scope, code) [delete: restrict]
Ref: CrawledListing.crawl_run_id > CrawlRun.crawl_run_id [delete: restrict]
Ref: CrawledListing.matched_variant_id > ProductVariant.variant_id [delete: set null]
Ref: CrawledListing.(status_scope, status_code) > Status.(scope, code) [delete: restrict]
Ref: SponsoredListing.offer_id > Offer.offer_id [delete: restrict]

// REFERENCE SEED DATA FOR LANGUAGE AND WORKFLOW STATUSES.
// Codex should seed these through EF Core (idempotently) when implementing V2.
// DBML Records document the intended values; they do not automatically execute in EF migrations.
Records Language(language_code, native_name, is_active) {
  'en', 'English', true
  'ar', 'العربية', true
}

Records Status(scope, code, label_en, label_ar, is_active, sort_order) {
  'crawl_run', 'pending', 'Pending', 'قيد الانتظار', true, 0
  'crawl_run', 'running', 'Running', 'قيد التنفيذ', true, 10
  'crawl_run', 'completed', 'Completed', 'مكتمل', true, 20
  'crawl_run', 'failed', 'Failed', 'فشل', true, 30
  'listing_match', 'pending', 'Pending', 'قيد الانتظار', true, 0
  'listing_match', 'matched', 'Matched', 'مطابق', true, 10
  'listing_match', 'unmatched', 'Unmatched', 'غير مطابق', true, 20
  'listing_match', 'review', 'Needs review', 'يحتاج مراجعة', true, 30
  'affiliate_conversion', 'pending', 'Pending', 'قيد الانتظار', true, 0
  'affiliate_conversion', 'approved', 'Approved', 'تمت الموافقة', true, 10
  'affiliate_conversion', 'rejected', 'Rejected', 'مرفوض', true, 20
  'affiliate_conversion', 'paid', 'Paid', 'مدفوع', true, 30
}
