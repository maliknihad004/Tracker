// Authoritative ERD verified against TrackerDbContext, InitialCreate SQL, and the live database.
// PostgreSQL identity columns use GENERATED BY DEFAULT AS IDENTITY.
// Unique alternate keys are shown as unique indexes; do not create a second index for them.
// __EFMigrationsHistory is EF infrastructure and excluded from the 21 application tables.
Project Tracker {
  database_type: 'PostgreSQL'
  Note: 'Verified final schema: 21 application tables; 140 columns; 30 foreign keys; 50 CHECK constraints; 60 physical indexes including primary/alternate keys and UX_User_Email. Applied migration: 20261017185206_InitialCreate. See TranslationDesign.md.'
}

Table "AffiliateConversion" {
  click_id integer [null]
  commission_amount numeric(18,2) [not null]
  conversion_id integer [not null, increment]
  currency varchar(3) [not null]
  external_conversion_id varchar(255) [null]
  merchant_id integer [not null]
  offer_id integer [null]
  order_amount numeric(18,2) [null]
  reported_at "timestamp with time zone" [not null, default: `now()`]
  status_id integer [not null]
  status_scope varchar(50) [not null, default: 'affiliate_conversion']

  indexes {
    conversion_id [pk, name: 'PK_AffiliateConversion']
    click_id [name: 'IX_AffiliateConversion_click_id']
    offer_id [name: 'IX_AffiliateConversion_offer_id']
    (status_id, status_scope) [name: 'IX_AffiliateConversion_status_id_status_scope']
    (merchant_id, external_conversion_id) [unique, name: 'UX_Conversion_Merchant_ExternalId']
  }

  checks {
    `commission_amount >= 0` [name: 'CK_Conversion_Commission']
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Conversion_Currency']
    `order_amount IS NULL OR order_amount >= 0` [name: 'CK_Conversion_OrderAmount']
    `status_scope = 'affiliate_conversion'` [name: 'CK_Conversion_StatusScope']
  }
}

Table "Category" {
  category_id integer [not null, increment]
  description_translation_key varchar(200) [null]
  is_active boolean [not null, default: true]
  name_translation_key varchar(200) [not null]
  parent_category_id integer [null]
  slug varchar(150) [not null]

  indexes {
    category_id [pk, name: 'PK_Category']
    parent_category_id [name: 'IX_Category_parent_category_id']
    name_translation_key [unique, name: 'UQ_Category_NameTranslationKey']
    slug [unique, name: 'UQ_Category_Slug']
  }

  checks {
    `description_translation_key IS NULL OR length(trim(description_translation_key)) > 0` [name: 'CK_Category_DescriptionTranslationKey']
    `length(trim(name_translation_key)) > 0` [name: 'CK_Category_NameTranslationKey']
    `parent_category_id IS NULL OR parent_category_id <> category_id` [name: 'CK_Category_NotOwnParent']
    `length(trim(slug)) > 0` [name: 'CK_Category_Slug']
  }

  Note: 'Application code creates namespaced keys (e.g. category_beauty_name, category_beauty_description) and required Translation rows in one transaction. No FK to Translation.key because it is not independently unique.'
}

Table "CrawledListing" {
  crawl_run_id integer [not null]
  crawled_at "timestamp with time zone" [not null, default: `now()`]
  currency varchar(3) [null]
  external_offer_id varchar(200) [null]
  listing_id integer [not null, increment]
  matched_variant_id integer [null]
  price numeric(18,2) [null]
  product_name varchar(255) [not null]
  product_url text [not null]
  raw_specifications jsonb [null]
  status_id integer [not null]
  status_scope varchar(50) [not null, default: 'listing_match']

  indexes {
    listing_id [pk, name: 'PK_CrawledListing']
    crawl_run_id [name: 'IX_CrawledListing_crawl_run_id']
    matched_variant_id [name: 'IX_CrawledListing_matched_variant_id']
    (status_id, status_scope) [name: 'IX_CrawledListing_status_id_status_scope']
  }

  checks {
    `currency IS NULL OR currency ~ '^[A-Z]{3}$'` [name: 'CK_Listing_Currency']
    `price IS NULL OR price > 0` [name: 'CK_Listing_Price']
    `price IS NULL OR currency IS NOT NULL` [name: 'CK_Listing_PriceCurrency']
    `raw_specifications IS NULL OR jsonb_typeof(raw_specifications) = 'object'` [name: 'CK_Listing_Specifications']
    `status_scope = 'listing_match'` [name: 'CK_Listing_StatusScope']
  }
}

Table "CrawlRun" {
  crawl_run_id integer [not null, increment]
  error_message text [null]
  finished_at "timestamp with time zone" [null]
  merchant_id integer [not null]
  products_found integer [not null, default: 0]
  started_at "timestamp with time zone" [null]
  status_id integer [not null]
  status_scope varchar(50) [not null, default: 'crawl_run']

  indexes {
    crawl_run_id [pk, name: 'PK_CrawlRun']
    merchant_id [name: 'IX_CrawlRun_merchant_id']
    (status_id, status_scope) [name: 'IX_CrawlRun_status_id_status_scope']
  }

  checks {
    `finished_at IS NULL OR (started_at IS NOT NULL AND finished_at >= started_at)` [name: 'CK_CrawlRun_Dates']
    `products_found >= 0` [name: 'CK_CrawlRun_ProductsFound']
    `status_scope = 'crawl_run'` [name: 'CK_CrawlRun_StatusScope']
  }
}

Table "Language" {
  code varchar(10) [not null]
  is_active boolean [not null, default: true]
  language_id integer [not null, increment]
  name varchar(100) [not null]

  indexes {
    language_id [pk, name: 'PK_Language']
    code [unique, name: 'UQ_Language_Code']
  }

  checks {
    `length(trim(code)) > 0` [name: 'CK_Language_Code']
    `length(trim(name)) > 0` [name: 'CK_Language_Name']
  }

  Note: 'Seeded languages: 1 = ar (العربية), 2 = en (English).'
}

Table "Merchant" {
  is_active boolean [not null, default: true]
  merchant_id integer [not null, increment]
  name varchar(255) [not null]
  supports_affiliate_links boolean [not null, default: false]
  website_url text [null]

  indexes {
    merchant_id [pk, name: 'PK_Merchant']
  }

  checks {
    `length(trim(name)) > 0` [name: 'CK_Merchant_Name']
  }
}

Table "Notification" {
  alert_id integer [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  is_read boolean [not null, default: false]
  message text [not null]
  notification_id integer [not null, increment]
  title text [not null]
  user_id integer [not null]

  indexes {
    notification_id [pk, name: 'PK_Notification']
    alert_id [name: 'IX_Notification_alert_id']
    user_id [name: 'IX_Notification_user_id']
  }
}

Table "Offer" {
  affiliate_url text [null]
  attributes jsonb [null]
  currency varchar(3) [not null]
  external_offer_id varchar(200) [null]
  is_available boolean [null]
  last_checked_at "timestamp with time zone" [not null]
  merchant_id integer [not null]
  offer_id integer [not null, increment]
  price numeric(18,2) [not null]
  product_url text [not null]
  shipping_cost numeric(18,2) [null]
  variant_id integer [not null]

  indexes {
    offer_id [pk, name: 'PK_Offer']
    (variant_id, currency, price) [name: 'IX_Offer_PriceComparison']
    (merchant_id, external_offer_id, variant_id) [unique, name: 'UX_Offer_Merchant_Listing_Variant']
  }

  checks {
    `attributes IS NULL OR jsonb_typeof(attributes) = 'object'` [name: 'CK_Offer_Attributes']
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Offer_Currency']
    `price > 0` [name: 'CK_Offer_Price']
    `length(trim(product_url)) > 0` [name: 'CK_Offer_ProductUrl']
    `shipping_cost IS NULL OR shipping_cost >= 0` [name: 'CK_Offer_Shipping']
  }
}

Table "PriceAlert" {
  alert_id integer [not null, increment]
  created_at "timestamp with time zone" [not null, default: `now()`]
  currency varchar(3) [not null]
  is_active boolean [not null, default: true]
  last_triggered_at "timestamp with time zone" [null]
  target_price numeric(18,2) [not null]
  user_id integer [not null]
  variant_id integer [not null]

  indexes {
    alert_id [pk, name: 'PK_PriceAlert']
    user_id [name: 'IX_PriceAlert_user_id']
    (variant_id, currency, target_price) [name: 'IX_PriceAlert_Variant_Currency']
  }

  checks {
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Alert_Currency']
    `last_triggered_at IS NULL OR last_triggered_at >= created_at` [name: 'CK_Alert_LastTriggered']
    `target_price > 0` [name: 'CK_Alert_TargetPrice']
  }
}

Table "PriceHistory" {
  currency varchar(3) [not null]
  offer_id integer [not null]
  price numeric(18,2) [not null]
  price_history_id integer [not null, increment]
  recorded_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    price_history_id [pk, name: 'PK_PriceHistory']
    (offer_id, recorded_at) [name: 'IX_PriceHistory_Offer_Date']
  }

  checks {
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_PriceHistory_Currency']
    `price > 0` [name: 'CK_PriceHistory_Price']
  }
}

Table "Product" {
  brand varchar(150) [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  description_translation_key varchar(200) [null]
  image_url text [null]
  is_active boolean [not null, default: true]
  name_translation_key varchar(200) [not null]
  product_id integer [not null, increment]
  specifications jsonb [null]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    product_id [pk, name: 'PK_Product']
    name_translation_key [unique, name: 'UQ_Product_NameTranslationKey']
  }

  checks {
    `updated_at >= created_at` [name: 'CK_Product_Dates']
    `name_translation_key ~ '[^[:space:]]'` [name: 'CK_Product_NameTranslationKey']
    `description_translation_key IS NULL OR description_translation_key ~ '[^[:space:]]'` [name: 'CK_Product_DescriptionTranslationKey']
    `description_translation_key IS NULL OR description_translation_key <> name_translation_key` [name: 'CK_Product_DistinctTranslationKeys']
    `specifications IS NULL OR jsonb_typeof(specifications) = 'object'` [name: 'CK_Product_Specifications']
  }

  Note: 'Product names/descriptions use generic Translation rows in any configured language. Generate a UUID once before insertion: product_<uuid>_name and product_<uuid>_description. Keys are stable logical references, not FKs to the nonunique Translation.key. Application code creates and validates required translations atomically.'
}

Table "ProductCategory" {
  category_id integer [not null]
  product_id integer [not null]

  indexes {
    (product_id, category_id) [pk, name: 'PK_ProductCategory']
    category_id [name: 'IX_ProductCategory_category_id']
  }
}

Table "ProductVariant" {
  attributes jsonb [null]
  gtin varchar(14) [null]
  image_url text [null]
  is_active boolean [not null, default: true]
  product_id integer [not null]
  variant_code varchar(100) [not null]
  variant_id integer [not null, increment]

  indexes {
    variant_id [pk, name: 'PK_ProductVariant']
    gtin [unique, name: 'UQ_ProductVariant_Gtin']
    (product_id, variant_code) [unique, name: 'UQ_Variant_ProductCode']
  }

  checks {
    `attributes IS NULL OR jsonb_typeof(attributes) = 'object'` [name: 'CK_Variant_Attributes']
    `length(trim(variant_code)) > 0` [name: 'CK_Variant_Code']
  }
}

Table "SavedCollection" {
  collection_id integer [not null, increment]
  created_at "timestamp with time zone" [not null, default: `now()`]
  description text [null]
  name varchar(255) [not null]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  user_id integer [not null]

  indexes {
    collection_id [pk, name: 'PK_SavedCollection']
    user_id [name: 'IX_SavedCollection_user_id']
  }

  checks {
    `updated_at >= created_at` [name: 'CK_Collection_Dates']
  }
}

Table "SavedCollectionItem" {
  collection_id integer [not null]
  collection_item_id integer [not null, increment]
  quantity integer [not null, default: 1]
  variant_id integer [not null]

  indexes {
    collection_item_id [pk, name: 'PK_SavedCollectionItem']
    variant_id [name: 'IX_SavedCollectionItem_variant_id']
    (collection_id, variant_id) [unique, name: 'UQ_Collection_Variant']
  }

  checks {
    `quantity > 0` [name: 'CK_CollectionItem_Quantity']
  }
}

Table "ShareLink" {
  collection_id integer [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  is_active boolean [not null, default: true]
  product_id integer [null]
  share_link_id integer [not null, increment]
  slug varchar(255) [not null]

  indexes {
    share_link_id [pk, name: 'PK_ShareLink']
    collection_id [name: 'IX_ShareLink_collection_id']
    product_id [name: 'IX_ShareLink_product_id']
    slug [unique, name: 'UQ_ShareLink_Slug']
  }

  checks {
    `(product_id IS NOT NULL AND collection_id IS NULL) OR (product_id IS NULL AND collection_id IS NOT NULL)` [name: 'CK_ShareLink_OneTarget']
    `length(trim(slug)) > 0` [name: 'CK_ShareLink_Slug']
  }
}

Table "ShareLinkClick" {
  click_id integer [not null, increment]
  clicked_at "timestamp with time zone" [not null, default: `now()`]
  offer_id integer [not null]
  share_link_id integer [not null]

  indexes {
    click_id [pk, name: 'PK_ShareLinkClick']
    offer_id [name: 'IX_ShareLinkClick_offer_id']
    share_link_id [name: 'IX_ShareLinkClick_share_link_id']
  }
}

Table "SponsoredListing" {
  currency varchar(3) [not null]
  end_date "timestamp with time zone" [not null]
  is_active boolean [not null, default: true]
  offer_id integer [not null]
  sponsored_listing_id integer [not null, increment]
  sponsorship_fee numeric(18,2) [null]
  start_date "timestamp with time zone" [not null]

  indexes {
    sponsored_listing_id [pk, name: 'PK_SponsoredListing']
    offer_id [name: 'IX_SponsoredListing_offer_id']
  }

  checks {
    `currency ~ '^[A-Z]{3}$'` [name: 'CK_Sponsored_Currency']
    `end_date > start_date` [name: 'CK_Sponsored_Dates']
    `sponsorship_fee IS NULL OR sponsorship_fee >= 0` [name: 'CK_Sponsored_Fee']
  }
}

Table "Status" {
  code varchar(50) [not null]
  is_active boolean [not null, default: true]
  scope varchar(50) [not null]
  sort_order integer [not null, default: 0]
  status_id integer [not null, increment]
  translation_key varchar(200) [not null]

  indexes {
    (status_id, scope) [unique, name: 'AK_Status_Id_Scope']
    status_id [pk, name: 'PK_Status']
    (scope, code) [unique, name: 'UQ_Status_Scope_Code']
    translation_key [unique, name: 'UQ_Status_TranslationKey']
  }

  checks {
    `length(trim(code)) > 0` [name: 'CK_Status_Code']
    `length(trim(scope)) > 0` [name: 'CK_Status_Scope']
    `length(trim(translation_key)) > 0` [name: 'CK_Status_TranslationKey']
  }

  Note: 'Initial IDs 1-4: crawl_run pending/running/completed/failed; 5-8: listing_match pending/matched/unmatched/review; 9-12: affiliate_conversion pending/approved/rejected/paid. Resolve IDs by (scope, code) when inserting workflows. AK_Status_Id_Scope is an alternate UNIQUE constraint supporting scope-safe FKs.'
}

Table "Translation" {
  key varchar(200) [not null]
  language_id integer [not null]
  translation_id integer [not null, increment]
  value text [not null]

  indexes {
    translation_id [pk, name: 'PK_Translation']
    language_id [name: 'IX_Translation_language_id']
    (key, language_id) [unique, name: 'UQ_Translation_Key_Language']
  }

  checks {
    `length(trim(key)) > 0` [name: 'CK_Translation_Key']
    `length(trim(value)) > 0` [name: 'CK_Translation_Value']
  }

  Note: 'Generic translations: one value per (key, language_id). Initial seeds: 24 exact Arabic/English status labels. Keys are logical references from Product, Category, and Status, with globally namespaced values.'
}

Table "User" {
  created_at "timestamp with time zone" [not null, default: `now()`]
  email varchar(255) [not null]
  is_active boolean [not null, default: true]
  name varchar(255) [not null]
  password_hash text [not null]
  preferred_language_id integer [null]
  user_id integer [not null, increment]

  indexes {
    user_id [pk, name: 'PK_User']
    (`LOWER(email)`) [unique, name: 'UX_User_Email']
  }

  checks {
    `length(trim(email)) > 0` [name: 'CK_User_Email']
    `length(trim(name)) > 0` [name: 'CK_User_Name']
  }
}

Ref FK_AffiliateConversion_Merchant: "AffiliateConversion".merchant_id > "Merchant".merchant_id [delete: restrict]
Ref FK_AffiliateConversion_Offer: "AffiliateConversion".offer_id > "Offer".offer_id [delete: set null]
Ref FK_AffiliateConversion_ShareLinkClick: "AffiliateConversion".click_id > "ShareLinkClick".click_id [delete: set null]
Ref FK_AffiliateConversion_Status: "AffiliateConversion".(status_id, status_scope) > "Status".(status_id, scope) [delete: restrict]
Ref FK_Category_Category: "Category".parent_category_id > "Category".category_id [delete: restrict]
Ref FK_CrawledListing_CrawlRun: "CrawledListing".crawl_run_id > "CrawlRun".crawl_run_id [delete: restrict]
Ref FK_CrawledListing_ProductVariant: "CrawledListing".matched_variant_id > "ProductVariant".variant_id [delete: set null]
Ref FK_CrawledListing_Status: "CrawledListing".(status_id, status_scope) > "Status".(status_id, scope) [delete: restrict]
Ref FK_CrawlRun_Merchant: "CrawlRun".merchant_id > "Merchant".merchant_id [delete: restrict]
Ref FK_CrawlRun_Status: "CrawlRun".(status_id, status_scope) > "Status".(status_id, scope) [delete: restrict]
Ref FK_Notification_PriceAlert: "Notification".alert_id > "PriceAlert".alert_id [delete: set null]
Ref FK_Notification_User: "Notification".user_id > "User".user_id [delete: restrict]
Ref FK_Offer_Merchant: "Offer".merchant_id > "Merchant".merchant_id [delete: restrict]
Ref FK_Offer_ProductVariant: "Offer".variant_id > "ProductVariant".variant_id [delete: restrict]
Ref FK_PriceAlert_ProductVariant: "PriceAlert".variant_id > "ProductVariant".variant_id [delete: restrict]
Ref FK_PriceAlert_User: "PriceAlert".user_id > "User".user_id [delete: restrict]
Ref FK_PriceHistory_Offer: "PriceHistory".offer_id > "Offer".offer_id [delete: restrict]
Ref FK_ProductCategory_Category: "ProductCategory".category_id > "Category".category_id [delete: restrict]
Ref FK_ProductCategory_Product: "ProductCategory".product_id > "Product".product_id [delete: cascade]
Ref FK_ProductVariant_Product: "ProductVariant".product_id > "Product".product_id [delete: restrict]
Ref FK_SavedCollection_User: "SavedCollection".user_id > "User".user_id [delete: restrict]
Ref FK_SavedCollectionItem_ProductVariant: "SavedCollectionItem".variant_id > "ProductVariant".variant_id [delete: restrict]
Ref FK_SavedCollectionItem_SavedCollection: "SavedCollectionItem".collection_id > "SavedCollection".collection_id [delete: cascade]
Ref FK_ShareLink_Product: "ShareLink".product_id > "Product".product_id [delete: restrict]
Ref FK_ShareLink_SavedCollection: "ShareLink".collection_id > "SavedCollection".collection_id [delete: restrict]
Ref FK_ShareLinkClick_Offer: "ShareLinkClick".offer_id > "Offer".offer_id [delete: restrict]
Ref FK_ShareLinkClick_ShareLink: "ShareLinkClick".share_link_id > "ShareLink".share_link_id [delete: restrict]
Ref FK_SponsoredListing_Offer: "SponsoredListing".offer_id > "Offer".offer_id [delete: restrict]
Ref FK_Translation_Language: "Translation".language_id > "Language".language_id [delete: restrict]
Ref FK_User_Language: "User".preferred_language_id > "Language".language_id [delete: restrict]
